---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Card } from '@/components/card'
import SimpleLayout from '@/components/SimpleLayout.astro'
import { projects } from '@/lib/projects'
---

<BaseLayout
  title="Projects - mask.dev"
  description="Selected work across AI, code intelligence, and developer systems."
>
  <SimpleLayout
    title="Selected work across AI, code intelligence, and developer systems."
    intro="Focused projects spanning code review, graph databases, and AI tooling for developers."
  >
    <ul class="grid grid-cols-1 gap-x-12 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <Card as="li">
          <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-md bg-cyan-400/10 font-mono text-sm text-cyan-400 ring-1 ring-cyan-400/20">
            {project.title.slice(0, 2).toUpperCase()}
          </div>
          <h2 class="mt-6 text-base font-medium text-neutral-200">
            <Card.Link href={`/projects/${project.slug}`}>{project.title}</Card.Link>
          </h2>
          <Card.Description>{project.description}</Card.Description>
          <p class="relative z-10 mt-6 flex text-sm font-light text-neutral-500 transition group-hover:text-neutral-300">
            <span>{project.category}</span>
          </p>
        </Card>
      ))}
    </ul>
  </SimpleLayout>
</BaseLayout>
