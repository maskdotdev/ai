---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Container } from '@/components/container'
import { InteractiveTitle } from '@/components/interactive-title'
import { projects } from '@/lib/projects'

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props
const workflow = 'workflow' in project ? project.workflow : []
const architecture = 'architecture' in project ? project.architecture : []
---

<BaseLayout
  title={`${project.title} - mask.dev`}
  description={project.description}
>
  <Container className="mt-16 sm:mt-28">
    <article>
      <p class="font-mono text-sm font-medium uppercase tracking-[0.08em] text-cyan-400">
        Work / {project.title}
      </p>
      <InteractiveTitle
        client:visible
        text={project.title}
        className="mt-6 text-6xl font-semibold tracking-tight text-white sm:text-8xl"
        wrapText={false}
      />
      <p class="mt-6 max-w-4xl text-2xl font-light leading-snug text-neutral-200">
        {project.description}
      </p>
      <p class="mt-6 max-w-3xl text-base font-light leading-8 text-neutral-500">
        {project.overview}
      </p>

      <dl class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm font-light text-neutral-400">
        <div>{project.status}</div>
        <div aria-hidden="true">/</div>
        <div>{project.role}</div>
        <div aria-hidden="true">/</div>
        <div>{project.stack}</div>
      </dl>

      <div class="mt-20 space-y-12">
        <section>
          <h2 class="text-2xl font-light tracking-tight text-white">Overview</h2>
          <p class="mt-4 max-w-5xl text-base font-light leading-7 text-neutral-500">
            {project.overview}
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-light tracking-tight text-white">Why it matters</h2>
          <p class="mt-4 max-w-5xl text-base font-light leading-7 text-neutral-500">
            {project.why}
          </p>
        </section>

        {
          workflow.length > 0 && (
            <section>
              <h2 class="text-2xl font-light tracking-tight text-white">How it works</h2>
              <div class="mt-8 grid gap-5 md:grid-cols-2">
                {workflow.map((step, index) => (
                  <div class="border-l border-white/10 pl-5">
                    <p class="font-mono text-xs font-medium uppercase tracking-[0.08em] text-cyan-400">
                      Step {String(index + 1).padStart(2, '0')}
                    </p>
                    <h3 class="mt-2 text-base font-medium text-white">{step.title}</h3>
                    <p class="mt-3 text-sm font-light leading-6 text-neutral-500">
                      {step.description}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          architecture.length > 0 && (
            <section>
              <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <h2 class="text-2xl font-light tracking-tight text-white">
                  Architecture
                </h2>
                <p class="max-w-2xl text-sm font-light leading-6 text-neutral-500">
                  The crates stay narrow so parser code, storage mutation, query
                  behavior, and CLI commands can evolve independently.
                </p>
              </div>
              <div class="mt-8 divide-y divide-white/[0.06] border-y border-white/[0.06]">
                {architecture.map((part) => (
                  <div class="grid gap-3 py-5 sm:grid-cols-[10rem_1fr] sm:gap-8">
                    <h3 class="font-mono text-sm text-cyan-400">{part.name}</h3>
                    <p class="text-sm font-light leading-6 text-neutral-500">
                      {part.description}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <section>
          <h2 class="text-2xl font-light tracking-tight text-white">System</h2>
          <div class="mt-7 grid gap-8 md:grid-cols-3">
            {
              project.systems.map((system, index) => (
                <div>
                  <p class="font-mono text-sm text-cyan-400">
                    {String(index + 1).padStart(2, '0')}
                  </p>
                  <h3 class="mt-2 text-base font-medium text-white">{system.title}</h3>
                  <p class="mt-3 text-sm font-light leading-6 text-neutral-500">
                    {system.description}
                  </p>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </article>
  </Container>
</BaseLayout>
