---
import { InteractiveTitle } from '@/components/interactive-title'
import { projects } from '@/lib/projects'

const work = projects.map((project, index) => ({
  title: project.title,
  description: project.description,
  category: project.category,
  href: 'externalUrl' in project ? project.externalUrl : `/projects/${project.slug}`,
  icon: ['eye', 'grid', 'flask'][index],
}))

const nav = [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '/uses' },
  { label: 'Writing', href: '/articles' },
  { label: 'Contact', href: 'mailto:hello@mask.dev' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mask.dev - Building intelligent systems</title>
    <meta
      name="description"
      content="AI engineer and systems builder focused on code intelligence, developer tools, graph databases, and infrastructure."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="home-shell">
    <div class="scene-noise" aria-hidden="true"></div>
    <div class="scene-glow" aria-hidden="true"></div>
    <div class="scene-frame">
      <header class="site-header" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="mask.dev home">
          <span>mask</span><span>.dev</span>
        </a>
        <nav>
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <p class="eyebrow">AI Engineer <span></span> Systems Builder</p>
          <InteractiveTitle
            client:visible
            id="hero-title"
            text="Building intelligent systems."
            className="home-title"
            wrapText={false}
          />
          <p class="lede">AI, code intelligence, and developer tools.</p>
          <p class="intro">
            Staff-level engineer focused on building precise systems for
            developers, spanning code review, graph databases, and
            infrastructure that scales with impact.
          </p>
          <div class="actions" aria-label="Primary actions">
            <a class="button button-primary" href="#work">
              View Work
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13m-5-5 5 5-5 5" />
              </svg>
            </a>
            <a class="button button-secondary" href="mailto:hello@mask.dev">
              Get in Touch
            </a>
          </div>
        </section>

        <section class="selected-work" id="work" aria-labelledby="work-title">
          <div class="section-label">
            <h2 id="work-title">Selected Work</h2>
            <span></span>
          </div>
          <div class="work-list">
            {work.map((item) => (
              <a class="work-row" href={item.href}>
                <span class="work-icon" aria-hidden="true">
                  {item.icon === 'eye' && (
                    <svg viewBox="0 0 32 32">
                      <path d="M3.5 16s4.7-7.2 12.5-7.2S28.5 16 28.5 16 23.8 23.2 16 23.2 3.5 16 3.5 16Z" />
                      <circle cx="16" cy="16" r="3.8" />
                    </svg>
                  )}
                  {item.icon === 'grid' && (
                    <svg viewBox="0 0 32 32">
                      <path d="M8 8h.1M16 8h.1M24 8h.1M8 16h.1M16 16h.1M24 16h.1M8 24h.1M16 24h.1M24 24h.1" />
                    </svg>
                  )}
                  {item.icon === 'flask' && (
                    <svg viewBox="0 0 32 32">
                      <path d="M12 5h8M14 5v7.4L8.4 23.3c-.9 1.8.4 3.7 2.4 3.7h10.4c2 0 3.3-2 2.4-3.7L18 12.4V5" />
                      <path d="M11.3 21h9.4" />
                    </svg>
                  )}
                </span>
                <InteractiveTitle
                  client:visible
                  as="span"
                  text={item.title}
                  className="work-title"
                  maxPoints={120}
                  wrapText={false}
                />
                <span class="work-description">{item.description}</span>
                <span class="work-category">{item.category}</span>
                <span class="work-arrow" aria-hidden="true">
                  <svg viewBox="0 0 40 24">
                    <path d="M4 12h26" />
                    <path d="m23 5 7 7-7 7" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <span>© 2026 mask.dev</span>
        <span class="availability"><i></i>Open to new opportunities</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(html) {
    background: #010405;
    overflow-x: clip;
    scroll-behavior: smooth;
  }

  :global(.home-shell) {
    min-height: 100vh;
    margin: 0;
    overflow-x: clip;
    background:
      radial-gradient(circle at 62% 45%, rgba(7, 209, 226, 0.18), transparent 22rem),
      radial-gradient(circle at 76% 30%, rgba(12, 55, 64, 0.24), transparent 30rem),
      linear-gradient(135deg, #010405 0%, #020707 52%, #010303 100%);
    color: #f6f6f3;
    font-family:
      'DM Sans',
      ui-sans-serif,
      system-ui,
      sans-serif;
  }

  .scene-frame {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    display: flex;
    min-height: 100vh;
    width: min(100%, 1920px);
    margin: 0 auto;
    flex-direction: column;
    padding: clamp(1.5rem, 3.6vw, 3.75rem) clamp(1.25rem, 5.35vw, 6.25rem)
      clamp(1.25rem, 3.3vw, 3.5rem);
  }

  .scene-noise,
  .scene-glow {
    pointer-events: none;
    position: fixed;
    inset: 0;
  }

  .scene-noise {
    z-index: 3;
    opacity: 0.12;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
    background-size: 4px 4px;
    mix-blend-mode: screen;
  }

  .scene-glow {
    z-index: 0;
    background:
      radial-gradient(ellipse at 50% 50%, transparent 0%, transparent 46%, rgba(0, 0, 0, 0.72) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.64), transparent 18%, transparent 82%, rgba(0, 0, 0, 0.68));
  }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-block: 0.35rem;
    background: rgba(1, 4, 5, 0.72);
    backdrop-filter: blur(18px);
  }

  .brand {
    color: #f6f6f3;
    font-size: clamp(1.7rem, 2.05vw, 2.25rem);
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    letter-spacing: 0;
  }

  .brand span:last-child {
    color: #20dbe9;
  }

  nav {
    display: flex;
    gap: clamp(1.75rem, 4vw, 4.25rem);
  }

  nav a {
    color: rgba(246, 246, 243, 0.68);
    font-size: 0.98rem;
    text-decoration: none;
    transition: color 160ms ease;
  }

  nav a:hover {
    color: #f6f6f3;
  }

  main {
    flex: 1;
  }

  .hero {
    max-width: 58rem;
    padding-top: clamp(6rem, 11.2vw, 12rem);
  }

  .eyebrow,
  .section-label h2,
  .work-category {
    color: #20dbe9;
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: clamp(0.72rem, 0.78vw, 0.9rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 2rem;
  }

  .eyebrow span {
    display: inline-block;
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 999px;
    background: #20dbe9;
  }

  :global(.home-title) {
    margin: 0;
    max-width: none;
    color: #ffffff;
    font-size: clamp(3.35rem, 5.1vw, 6.55rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.045em;
    white-space: nowrap;
    text-shadow: 0 0 24px rgba(255, 255, 255, 0.16);
  }

  .lede {
    margin: 1.1rem 0 0;
    color: rgba(246, 246, 243, 0.62);
    font-size: clamp(2.1rem, 3.1vw, 4.25rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 39rem;
    margin: 2.5rem 0 0;
    color: rgba(246, 246, 243, 0.7);
    font-size: clamp(1.02rem, 1.18vw, 1.35rem);
    font-weight: 300;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .button {
    display: inline-flex;
    min-width: 13.5rem;
    height: 4rem;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    color: #f8faf9;
    font-size: 1rem;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .button svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button-primary {
    border-color: rgba(32, 219, 233, 0.8);
    background: linear-gradient(135deg, #37f2ff, #22b7cf);
    color: #031113;
    box-shadow: 0 0 28px rgba(32, 219, 233, 0.22);
  }

  .button-secondary {
    background: rgba(255, 255, 255, 0.02);
  }

  .button-secondary:hover {
    border-color: rgba(255, 255, 255, 0.58);
    background: rgba(255, 255, 255, 0.05);
  }

  .selected-work {
    margin-top: clamp(5.5rem, 9vw, 10.5rem);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .section-label h2 {
    flex: none;
    margin: 0;
  }

  .section-label span {
    height: 1px;
    flex: 1;
    background: rgba(255, 255, 255, 0.16);
  }

  .work-list {
    margin-top: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }

  .work-row {
    display: grid;
    grid-template-columns: 5.75rem minmax(12rem, 26vw) minmax(20rem, 1fr) 13rem 2rem;
    gap: 1.6rem;
    align-items: center;
    min-height: 10rem;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    color: inherit;
    text-decoration: none;
    transition:
      background 180ms ease,
      border-color 180ms ease;
  }

  .work-row:hover {
    background: linear-gradient(90deg, rgba(32, 219, 233, 0.045), transparent 58%);
    border-color: rgba(32, 219, 233, 0.24);
  }

  .work-icon {
    display: grid;
    width: 4.1rem;
    height: 4.1rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 5px;
    color: #20dbe9;
  }

  .work-icon svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  :global(.work-title) {
    color: #fff;
    font-size: clamp(3.25rem, 5.35vw, 6rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.94;
  }

  .work-description {
    max-width: 35rem;
    color: rgba(246, 246, 243, 0.58);
    font-size: clamp(0.96rem, 1vw, 1.15rem);
    font-weight: 300;
    line-height: 1.5;
  }

  .work-category {
    justify-self: start;
    white-space: nowrap;
  }

  .work-arrow {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border: 1px solid rgba(32, 219, 233, 0.16);
    border-radius: 999px;
    background: rgba(32, 219, 233, 0.035);
    color: rgba(32, 219, 233, 0.72);
    box-shadow: inset 0 0 18px rgba(32, 219, 233, 0.04);
    transition:
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .work-arrow svg {
    width: 1.9rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .work-row:hover .work-arrow {
    border-color: rgba(32, 219, 233, 0.42);
    color: #20dbe9;
    box-shadow: 0 0 20px rgba(32, 219, 233, 0.14);
    transform: translateX(0.3rem);
  }

  .site-footer {
    margin-top: 3.3rem;
    color: rgba(246, 246, 243, 0.26);
    font-size: 0.98rem;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: rgba(246, 246, 243, 0.48);
  }

  .availability i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: #20dbe9;
    box-shadow: 0 0 12px rgba(32, 219, 233, 0.72);
  }

  @media (max-width: 980px) {
    nav {
      gap: 1.35rem;
    }

    .work-row {
      grid-template-columns: 4.75rem 1fr 2rem;
      gap: 1rem;
      padding: 1.8rem 0;
    }

    .work-description,
    .work-category {
      grid-column: 2 / 3;
    }

    .work-arrow {
      grid-column: 3;
      grid-row: 1 / 4;
      justify-self: end;
    }
  }

  @media (max-width: 680px) {
    .scene-frame {
      padding: 1.35rem 1.1rem 1.5rem;
    }

    .site-header,
    .site-footer {
      align-items: flex-start;
      gap: 1.4rem;
    }

    .site-header {
      flex-direction: column;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.8rem;
    }

    nav a {
      font-size: 0.88rem;
    }

    .hero {
      padding-top: 4.6rem;
    }

    :global(.home-title) {
      font-size: clamp(3rem, 15vw, 5rem);
      white-space: normal;
    }

    .lede {
      font-size: clamp(1.85rem, 9vw, 3.15rem);
    }

    .actions {
      gap: 0.85rem;
    }

    .button {
      width: 100%;
      min-width: 0;
      height: 3.65rem;
    }

    .work-row {
      grid-template-columns: 3.7rem minmax(0, 1fr) 1.5rem;
      min-height: 0;
    }

    .work-icon {
      width: 3.1rem;
      height: 3.1rem;
    }

    .work-icon svg {
      width: 1.55rem;
      height: 1.55rem;
    }

    :global(.work-title) {
      font-size: clamp(3rem, 12vw, 4.6rem);
    }

    .site-footer {
      flex-direction: column-reverse;
      font-size: 0.9rem;
    }
  }
</style>
